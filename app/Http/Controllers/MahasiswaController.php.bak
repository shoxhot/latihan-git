<?php

namespace App\Http\Controllers;

use App\Models\Mahasiswa;
use Illuminate\Http\Request;

class MahasiswaController extends Controller
{
    public function index() {$mahasiswa = Mahasiswa::all(); return view('mahasiswa.index', compact('mahasiswa')); }
    public function create() { return 'create: form tambah mahasiswa'; }
    public function show(Mahasiswa $mahasiswa) { return view('mahasiswa.show', compact('mahasiswa')); }
    public function edit($nim) { return "edit: form edit mahasiswa NIM {$nim}"; }
    public function update(Request $request, $nim) { return "update: perbarui data NIM {$nim}"; }
    public function destroy($nim) { return "destroy: hapus data NIM {$nim}"; }
    public function store(Request $request) {
        $nama = $request->input('nama');
        $nim = $request->input('nim');
        return "Data yang diterima -> NIM: {$nim}, Nama: {$nama}";
    }
    public function cariMahasiswa(Request $request) {
        $nama = $request->input('nama');
        if (!$nama) {
            return 'Kata kunci pencarian belum diisi.';
        }
        return "Anda mencari mahasiswa dengan nama: {$nama}";
    }
    public function apiIndex()
    {
        return response()->json([
            'status' => 'sukses',
            'pesan' => 'Ini contoh response JSON dari Controller',
        ]);
    }
}


